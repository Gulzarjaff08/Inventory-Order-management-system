# ─── Local Development (Docker Compose) ─────────────────────────────────────

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=inventory_order_management_db

# Ports (for local docker-compose)
PORT_DB=5001
PORT_BACKEND=5002
PORT_FRONTEND=5003

# ─── Production (set these in Render / Netlify dashboards) ───────────────────

# Render backend env var — paste your Neon connection string here
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Netlify build env var — your Render backend public URL
VITE_API_URL=https://your-service-name.onrender.com
